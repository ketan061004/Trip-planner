# ---- Server ----
PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ---- AI provider ----
# Which provider to use: "groq" or "gemini"
AI_PROVIDER=groq

# Groq (https://console.groq.com/keys) - free, very fast
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (https://aistudio.google.com/apikey) - free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Database (MongoDB) ----
# Local: mongodb://127.0.0.1:27017/tripplanner
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/tripplanner
MONGODB_URI=mongodb://127.0.0.1:27017/tripplanner

# ---- Auth (JWT) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Images (Pexels) ----
# Free key: https://www.pexels.com/api/  (leave blank to use keyless fallback images)
PEXELS_API_KEY=

# ---- App ----
APP_URL=http://localhost:3000

# ---- Email (optional). If blank, password-reset tokens are logged/returned in dev mode ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
